APP_NAME=Harmony Spa API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Reemplaza usuario, contraseña y host por los de tu instalación local.
DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/harmony_spa?charset=utf8mb4

# Secretos y tiempos de autenticación (Fase 2).
# Genera una clave segura de mínimo 32 caracteres.
JWT_SECRET_KEY=cambia_esta_clave_secreta_por_una_de_minimo_32_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_INACTIVITY_MINUTES=30